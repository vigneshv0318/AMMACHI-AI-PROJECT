# ==========================================
# Ammachi AI Platform - Environment Config
# ==========================================

# Database Configuration (PostgreSQL + Psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ammachi_db
# Supabase (Project Settings -> Database -> Connection string -> "Session pooler"):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud AI (High-speed fallback)
GROQ_API_KEY=your_groq_api_key_here

# Deepgram Speech-to-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs Emotive Voice (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=ThT5KcBeYPX3keUQqHPh

# YouTube Data API v3 (Optional - for cultural videos)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google OAuth 2.0 Client Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# JWT Secret & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend & Server
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
PORT=8000

# Bodhan IndicOCR (handwriting OCR + /ocr endpoint)
# Leave BODHAN_API_KEY empty to fall back to Groq vision OCR
BODHAN_API_KEY=
BODHAN_OCR_ENDPOINT=https://api.bodhan.ai/v1/chat/completions

# Supabase Storage (profile photos)
# Key: Supabase -> Project Settings -> API Keys -> "service_role" / secret key (keep it private, backend only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
